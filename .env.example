# Copy to .env (never committed). Clo reads these at startup.
ANTHROPIC_API_KEY=
CLO_MODEL=claude-opus-5-5
CLO_EFFORT=high
CLO_DB=data/clo.db
CLO_SEND=0                 # 1 = really send; anything else = dry run (logs only)
CLO_APPROVERS=cloe@example.org
CLO_TIMEZONE=Europe/Amsterdam
CLO_QUIET_HOURS=20:00-08:00
CLO_MAX_MSGS_PER_PERSON_PER_14D=1
CLO_ALLOWED_LINK_DOMAINS=space13.to,tell.newtexeco.nl,newtexeco.nl,cordis.europa.eu

# Email (Sprint 5)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Clo (TOS13) <hello@space13.to>"
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# SMS (Sprint 5)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
CLO_WEBHOOK_SECRET=

# TELL (optional, Sprint 1)
TELL_DB_URL=                # mysql+pymysql://user:pass@host:25060/defaultdb
TELL_DB_CA_CERT=
