# Copy to .env (never committed). Cloé reads these at startup.
ANTHROPIC_API_KEY=
CLOE_MODEL=claude-opus-5-5
CLOE_MODEL_BULK=             # empty = same as CLOE_MODEL; only the team changes it
CLOE_EFFORT=high
CLOE_DB=data/cloe.db
CLOE_SEND=0                 # 1 = really send; anything else = dry run (logs only)
CLOE_APPROVERS=cloe@example.org
CLOE_TIMEZONE=Europe/Amsterdam
CLOE_QUIET_HOURS=20:00-08:00
CLOE_MAX_MSGS_PER_PERSON_PER_14D=1
CLOE_ALLOWED_LINK_DOMAINS=space13.to,tell.newtexeco.nl,newtexeco.nl,cordis.europa.eu
# CLOE_CANARY is generated on first run and appended to .env. Never share it.

# Email (Sprint 5)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Cloé (AI) · TOS13 <hello@space13.to>"
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# SMS (Sprint 5)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
CLOE_WEBHOOK_SECRET=

# Join form (Sprint 1): the "TOS13 join form responses" Google Sheet, read-only.
# Share the sheet with the service account's address as Viewer. Keep the key file outside
# the repo or under secrets/ (ignored). Without these, `cloe ingest joinform <file>` still
# reads a CSV/XLSX export.
CLOE_JOINFORM_SHEET_ID=     # the id in the sheet's URL: docs.google.com/spreadsheets/d/<id>/
GOOGLE_SERVICE_ACCOUNT_FILE=  # path to the service account's JSON key

# TELL (optional, Sprint 1)
TELL_DB_URL=                # mysql+pymysql://user:pass@host:25060/defaultdb
TELL_DB_CA_CERT=
